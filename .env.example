# VM connection settings
VM_HOST=192.168.122.79
VM_USER=vmrobot
VM_PORT=22
VM_DISPLAY=:0

# Optional: path to SSH private key (leave empty for agent/password auth)
VM_IDENTITY=

# Optional: path to known_hosts file for SSH host key verification
# Default is disabled (None) for local ephemeral QEMU VMs whose host keys
# change on every rebuild. Set to a path to enable verification.
VM_KNOWN_HOSTS=

# Optional: desktop session owner (if different from VM_USER).
# Used by ssh_execute(as_desktop_user=True) for clipboard, pass, dbus, etc.
VM_DESKTOP_USER=

# Optional: SSH connection timeout in seconds (default: 10)
VM_CONNECT_TIMEOUT=10
